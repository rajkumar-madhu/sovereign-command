# Production runtime (Node / Docker)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Browser calls same-origin /stage1-api. Server proxies to STAGE1_API_URL.
# STAGE1_API_URL=http://127.0.0.1:8091
# VITE_STAGE1_API_URL=/stage1-api

# Multi-tenant operator sessions. Creating a user does not grant cluster access.
# AEGIS_SESSION_SECRET=generate-with-openssl-rand-hex-32
# AEGIS_TENANT_TOKENS=finspot-dev:<sha256-hex-of-tenant-token>

# Build-time (optional)
# NITRO_PRESET=node-server          # default for Docker/K8s
# NITRO_PRESET=cloudflare-module    # Cloudflare Workers
# SOURCEMAP=true                    # emit production sourcemaps
